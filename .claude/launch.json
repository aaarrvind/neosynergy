{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "dev-fallback",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_SUPABASE_URL=placeholder", "npm", "run", "dev"],
      "port": 3000
    }
  ]
}
