# ---------------------------------------------------------------
# Email (quote requests & contact form)
# ---------------------------------------------------------------
# Create a free account at https://resend.com, verify your sending
# domain (e.g. neosynergy.ae), and create an API key.
RESEND_API_KEY=

# The "From" address used when sending quote/confirmation emails.
# Must be on a domain you have verified in Resend.
# Example: "Neo Synergy Website <quotes@neosynergy.ae>"
QUOTE_FROM_EMAIL="Neo Synergy Website <quotes@neosynergy.ae>"

# Comma-separated list of addresses that receive new quote requests.
SALES_EMAILS="sales@neosynergy.ae,info@neosynergy.ae"

# ---------------------------------------------------------------
# If RESEND_API_KEY is left empty, /api/quote will log submissions
# to the server console instead of sending email — useful for local
# development without an email provider configured.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Supabase (database + auth + storage)
# ---------------------------------------------------------------
# Create a project at https://supabase.com, then copy these from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
